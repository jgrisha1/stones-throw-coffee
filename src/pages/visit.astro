---
import Base from '../layouts/Base.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { BUSINESS, fullAddress, has, hasStreetAddress, hoursDisplay, hoursNote } from '../config';

const hours = hoursDisplay();
const hasLocation = hasStreetAddress();
const mapsUrl = hasLocation
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress())}`
  : '';
const mapEmbed = hasLocation
  ? `https://www.google.com/maps?q=${encodeURIComponent(fullAddress())}&output=embed`
  : '';
const socials = [
  { label: 'Instagram', url: BUSINESS.social.instagram },
  { label: 'Facebook', url: BUSINESS.social.facebook },
  { label: 'Threads', url: BUSINESS.social.threads },
].filter((s) => has(s.url));
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
---

<Base
  title="Visit Stone's Throw Coffee | South Knoxville"
  description="Visit Stone's Throw Coffee at 3615A Chapman Hwy in South Knoxville, the former South Press space. Address, hours, directions, and accessibility."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Location, hours &amp; access</p>
      <h1>Visit Stone&rsquo;s Throw Coffee</h1>
      <p class="lede">
        We&rsquo;ve found our home: 3615A Chapman Highway in South Knoxville, the former South Press
        space. Painting has started. Hours and accessibility details are below, and parking notes
        will be posted before opening day.
      </p>

      <div class="grid">
        <div class="card">
          <h2>Address</h2>
          {hasLocation ? (
            <>
              <address>
                {BUSINESS.name}<br />
                {BUSINESS.address.street}<br />
                {BUSINESS.address.city}, {BUSINESS.address.state} {BUSINESS.address.zip}
              </address>
              <p style="margin-top: var(--space-2);">
                <a href={mapsUrl} rel="noopener">Open in Google Maps</a>
              </p>
            </>
          ) : (
            <p>South Knoxville. Exact location to be announced after the lease is signed.</p>
          )}
        </div>
        <div class="card">
          <h2>Hours</h2>
          {
            hours.length ? (
              <>
                <ul style="list-style:none; padding:0; margin:0;">
                  {hours.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
                <p class="menu-item__desc" style="margin-top: var(--space-1);">{hoursNote()}</p>
              </>
            ) : (
              <p>
                Opening date and hours coming soon. We&rsquo;ll post them here and on our Google
                profile as soon as they&rsquo;re set.
              </p>
            )
          }
        </div>
        <div class="card">
          <h2>Contact</h2>
          <ul style="list-style:none; padding:0; margin:0;">
            {
              has(BUSINESS.phoneDisplay) && has(BUSINESS.phone) && (
                <li>
                  <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>
                </li>
              )
            }
            {
              has(BUSINESS.email) && (
                <li>
                  <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
                </li>
              )
            }
            {
              socials.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">
                    {s.label}
                  </a>
                </li>
              ))
            }
            <li><a href={`${base}/contact/`}>Contact &amp; event booking</a></li>
          </ul>
        </div>
      </div>

      {hasLocation && (
        <>
          <h2>Map</h2>
          <!-- Privacy by default: the Google embed (which can set its own cookies)
               is not loaded until the visitor explicitly asks for it. -->
          <div class="map-consent" id="map-consent">
            <p class="map-consent__note">
              The map is embedded from Google and may set its own cookies, so it loads only when you
              choose to.
            </p>
            <button type="button" class="btn btn--clay" id="map-load-btn">Load the Google map</button>
            <p class="map-consent__alt">
              Or <a href={mapsUrl} rel="noopener">open the location in Google Maps</a> in a new tab.
            </p>
          </div>
          <template id="map-embed-template">
            <iframe
              class="map-embed"
              src={mapEmbed}
              title={`Map showing ${BUSINESS.name} at ${fullAddress()}`}
              loading="lazy"
              frameborder="0"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </template>
          <script is:inline>
            (function () {
              var box = document.getElementById('map-consent');
              var tpl = document.getElementById('map-embed-template');
              var btn = document.getElementById('map-load-btn');
              if (!box || !tpl || !btn) return;
              btn.addEventListener('click', function () {
                var frame = tpl.content.firstElementChild.cloneNode(true);
                box.replaceWith(frame);
                frame.setAttribute('tabindex', '-1');
                if (frame.focus) frame.focus();
              });
            })();
          </script>
        </>
      )}

      <h2>Parking</h2>
      <p>
        We&rsquo;re confirming parking and overflow options now. We&rsquo;ll publish clear arrival
        notes before opening and for any event with special parking needs.
      </p>

      <h2>Accessibility</h2>
      <p>
        Every member of our staff will be trained to take orders in ASL and Spanish, so you can
        expect to order in either language. Most of our seating is wheelchair accessible and size inclusive, so you can pick a spot that fits you.
        More details about the entrance, restrooms, and parking will be posted before opening.
        Questions in the meantime? <a href={`${base}/contact/`}>Reach out</a>.
      </p>

      <h2>Getting here</h2>
      {hasLocation ? (
        <p>
          Detailed driving, walking, biking, and transit directions will stay current here. Check
          current bus times at <a href="https://www.katbus.com" target="_blank" rel="noopener noreferrer">katbus.com</a>
          before visiting.
        </p>
      ) : (
        <p>
          Driving, walking, biking, and transit directions will be added as soon as the address is
          confirmed.
        </p>
      )}

      <h2>While you&rsquo;re in the neighborhood</h2>
      <p>
        South Knoxville is worth the wander: the Urban Wilderness trails, Ijams Nature Center,
        the Mary Vestal and Baker Creek greenways, and local shops throughout the neighborhood.
      </p>

      <div class="btn-row">
        <a class="btn btn--clay" href={`${base}/menu/`}>View the menu</a>
        <a class="btn btn--clay" href={`${base}/events/`}>See upcoming events</a>
      </div>
    </div>
  </section>
  <EmailSignup />
</Base>
