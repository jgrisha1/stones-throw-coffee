---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmailSignup from '../../components/EmailSignup.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// pubDate is date-only frontmatter (parsed as UTC midnight) — format in UTC
// or the date renders one day early in US timezones.
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Base
  title="Updates & News | Stone's Throw Coffee in South Knoxville"
  description="News from Stone's Throw Coffee on Chapman Highway in South Knoxville — opening progress, menu news, and featured local artists and authors."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">From the shop</p>
      <h1>Updates &amp; News</h1>
      <p class="lede">
        Opening progress, menu news, featured artists and authors, and everything happening at
        the shop — written by us, not a marketing robot.
      </p>
      {
        posts.length > 0 ? (
          <div class="grid">
            {posts.map((post) => (
              <a class="card event-card" href={`/updates/${post.id}/`}>
                <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <p>First posts landing soon.</p>
        )
      }
    </div>
  </section>
  <EmailSignup />
</Base>
