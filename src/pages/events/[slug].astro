---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BUSINESS, fullAddress, hasStreetAddress } from '../../config';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const { title, start, description, audience, cost, accessibility, performers, rsvpUrl, image } =
  event.data;
const hasLocation = hasStreetAddress();
const eventLocation = hasLocation ? `${BUSINESS.name}, ${fullAddress()}` : 'South Knoxville, TN (exact location TBA)';

// Default the end time to two hours after start for calendar links/schema.
const end = event.data.end ?? new Date(start.valueOf() + 2 * 60 * 60 * 1000);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'America/New_York',
  });
const fmtTime = (d: Date) =>
  d.toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });

const canonical = new URL(`/events/${event.id}/`, Astro.site).href;
const gcalFmt = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const gcalUrl =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(`${title} | ${BUSINESS.name}`)}` +
  `&dates=${gcalFmt(start)}/${gcalFmt(end)}` +
  `&details=${encodeURIComponent(`${description}\n\n${canonical}`)}` +
  `&location=${encodeURIComponent(eventLocation)}`;

const isFree = !!cost && /free/i.test(cost);
const priceMatch = cost ? cost.match(/\$?(\d+(?:\.\d{1,2})?)/) : null;
const eventSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description,
  startDate: start.toISOString(),
  endDate: end.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  organizer: { '@type': 'Organization', name: BUSINESS.name, url: Astro.site?.href },
};
// Only state a price when the cost is known (free or a dollar amount); no cost set claims nothing.
if (isFree || priceMatch) {
  eventSchema.isAccessibleForFree = isFree;
  eventSchema.offers = {
    '@type': 'Offer',
    price: isFree ? '0' : priceMatch![1],
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: rsvpUrl ?? canonical,
  };
}
if (hasLocation) {
  eventSchema.location = {
    '@type': 'Place',
    name: BUSINESS.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: BUSINESS.address.street,
      addressLocality: BUSINESS.address.city,
      addressRegion: BUSINESS.address.state,
      postalCode: BUSINESS.address.zip,
      addressCountry: 'US',
    },
  };
}
// Google wants an image on events; fall back to the site share image.
eventSchema.image = new URL(image ?? '/images/og-stones-throw-coffee.webp', Astro.site).href;
if (performers.length) {
  eventSchema.performer = performers.map((p) => ({ '@type': 'Person', name: p.name }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/,'');

// Cross-links: the next few other upcoming events, so every event page links to its neighbors.
const now = new Date();
// Each upcoming event links to the next three after it (wrapping around), so every upcoming
// event page gets inbound links from its neighbors. Past events link to the soonest three.
const upcomingAll = (await getCollection('events', ({ data }) => !data.draft && data.start >= now)).sort(
  (a, b) => a.data.start.valueOf() - b.data.start.valueOf(),
);
const myIndex = upcomingAll.findIndex((e) => e.id === event.id);
const moreEvents =
  myIndex >= 0
    ? Array.from({ length: Math.min(3, upcomingAll.length - 1) }, (_, k) => upcomingAll[(myIndex + 1 + k) % upcomingAll.length])
    : upcomingAll.slice(0, 3);
const fmtShortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/New_York' });
---

<Base
  title={`${title} | Events at Stone's Throw Coffee`}
  description={description}
  ogType="article"
  ogImage={image}
  jsonLd={[eventSchema]}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><a href={`${base}/events/`}>&larr; All events</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>

      <ul class="event-meta">
        <li>
          <strong>{fmtDate(start)}</strong>, {fmtTime(start)}&ndash;{fmtTime(end)}
        </li>
        <li>
          {eventLocation}
        </li>
        {cost && <li>{cost}</li>}
        {audience && <li>{audience}</li>}
        {accessibility && <li>{accessibility}</li>}
      </ul>

      <div class="btn-row" style="margin-bottom: var(--space-4);">
        {rsvpUrl && <a class="btn btn--clay" href={rsvpUrl} rel="noopener">RSVP</a>}
        <a class="btn btn--clay" href={gcalUrl} rel="noopener">Add to Google Calendar</a>
        <a class="btn btn--clay" href={`${base}/visit/`}>Parking &amp; directions</a>
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        performers.length > 0 && (
          <>
            <h2>Featuring</h2>
            <div class="grid">
              {performers.map((p) => (
                <div class="card">
                  <h3>{p.url ? <a href={p.url} rel="noopener">{p.name}</a> : p.name}</h3>
                  {p.bio && <p>{p.bio}</p>}
                </div>
              ))}
            </div>
          </>
        )
      }

      {
        moreEvents.length > 0 && (
          <>
            <h2>Also coming up</h2>
            <div class="grid">
              {moreEvents.map((e) => (
                <a class="card event-card" href={`${base}/events/${e.id}/`}>
                  <time datetime={e.data.start.toISOString()}>{fmtShortDate(e.data.start)}</time>
                  <h3>{e.data.title}</h3>
                  <p>{e.data.description}</p>
                </a>
              ))}
            </div>
          </>
        )
      }
      <p>
        <a class="text-link" href={`${base}/events/`}>See all events</a> &middot;
        <a class="text-link" href={`${base}/menu/`}>See the menu</a> &middot;
        <a class="text-link" href={`${base}/updates/`}>Read our updates</a>
      </p>
    </div>
  </section>
</Base>
