---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmailSignup from '../../components/EmailSignup.astro';

const now = new Date();
const all = await getCollection('events', ({ data }) => !data.draft);
const upcoming = all
  .filter((e) => e.data.start >= now)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const past = all
  .filter((e) => e.data.start < now)
  .sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf())
  .slice(0, 6);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'America/New_York',
  });
const fmtTime = (d: Date) =>
  d.toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });
const fmtMonth = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', timeZone: 'America/New_York' }).toUpperCase();
const fmtDay = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'America/New_York' });
const fmtWeekday = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
// "4:00 PM to 6:00 PM" when the event has an end time, otherwise just the start
const fmtRange = (start: Date, end?: Date) =>
  (end ? `${fmtTime(start)} to ${fmtTime(end)}` : fmtTime(start)).replace(/\s(AM|PM)/g, ' $1'); // keep "9:00 AM" together when wrapping
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
---

<Base
  title="Events: Drag, Readings & Music | Stone's Throw Coffee"
  description="Upcoming events at Stone's Throw Coffee in South Knoxville: drag shows, author readings, acoustic music, open mics, art nights, and queer community gatherings."
>
  <section class="section">
    <div class="wrap">
      <div class="media-banner events-banner" aria-hidden="true" style={`background-image: linear-gradient(rgba(20,58,0,0.28), rgba(20,58,0,0.2)), url('${base}/images/events-cafe-interior.webp');`}></div>
      <p class="eyebrow">What&rsquo;s happening</p>
      <h1>Events at Stone&rsquo;s Throw Coffee</h1>
      <p class="lede">
        Events planned for our South Knoxville shop include drag shows, book clubs, open mics,
        workshops, craft nights, vendor markets, study nights, community meetups, author readings,
        poetry, and sober-friendly gatherings.
      </p>
      <p>
        We also feature local creators year-round. See the artists, authors, and makers on our
        <a href={`${base}/art-and-authors/`}>Local Art &amp; Makers</a> page, or
        <a href={`${base}/art-and-authors/`}>apply to be featured</a>.
      </p>

      <h2 id="upcoming">Upcoming events</h2>
      {
        upcoming.length > 0 ? (
          <ul class="event-list">
            {upcoming.map((event) => (
              <li>
                <a class="event-row" href={`${base}/events/${event.id}/`}>
                  <span class="event-row__date" aria-hidden="true">
                    <span class="event-row__month">{fmtMonth(event.data.start)}</span>
                    <span class="event-row__day">{fmtDay(event.data.start)}</span>
                  </span>
                  <span class="event-row__body">
                    <time datetime={event.data.start.toISOString()}>
                      {fmtWeekday(event.data.start)}, {fmtRange(event.data.start, event.data.end)}
                    </time>
                    <h3>{event.data.title}</h3>
                    <p>{event.data.description}</p>
                    {event.data.cost && <p class="event-row__cost">{event.data.cost}</p>}
                    <span class="event-row__more">Details and calendar link <span aria-hidden="true">&rarr;</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>New dates are being added. Check back soon, or join the email list below.</p>
        )
      }

      <div class="coming-soon-events" id="coming-soon">
        <h2>Also coming soon</h2>
        <p class="menu-item__desc">Dates and details to be announced.</p>
        <ul>
          <li class="host-card host-card--wide">
            <img
              class="host-card__logo"
              src={`${base}/images/sign-of-change-logo.webp`}
              width="320"
              height="320"
              loading="lazy"
              decoding="async"
              alt="Sign of Change logo: two rainbow-colored hands above the words Sign of Change, with the tagline Bridging Deaf and LGBTQ+ Communities"
            />
            <div class="host-card__body">
              <p class="host-card__title"><strong>ASL classes</strong> with Jake Barker</p>
              <p class="host-card__tagline"><em>Sign of Change: Bridging Deaf and LGBTQ+ Communities</em></p>
              <p>
                Sign of Change builds bridges between Deaf and hearing communities through inclusive
                education, cultural awareness, and advocacy. Jake leads its ASL classes, sensitivity
                trainings, and workshops.
              </p>
              <p>
                <a
                  class="tap-link"
                  href="https://www.facebook.com/profile.php?id=61575062193754"
                  target="_blank"
                  rel="noopener noreferrer">Sign of Change on Facebook</a>
              </p>
            </div>
          </li>
          <li class="host-card">
            <div class="host-card__body">
              <p class="host-card__title"><strong>Friendsgiving</strong></p>
              <p>Monday, November 23. Time and details TBD.</p>
            </div>
          </li>
          <li class="host-card">
            <div class="host-card__body">
              <p class="host-card__title">
                <strong>Poetics of Place: Writing at the Intersection of Queerness &amp; Nature</strong>
              </p>
              <p>A writing workshop hosted by Jaq Hackworthy.</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="pitch-note">
        <p>
          <strong>Want to be part of it?</strong> Local authors, musicians, poets, and artists:
          <a href={`${base}/art-and-authors/`}>apply to be featured</a> or
          <a href={`${base}/contact/`}>pitch an event</a>. Dates and times are posted here and sent
          to our email list.
        </p>
      </div>

      {
        past.length > 0 && (
          <>
            <h2>Recent events</h2>
            <ul class="event-list event-list--past">
              {past.map((event) => (
                <li>
                <a class="event-row" href={`${base}/events/${event.id}/`}>
                  <span class="event-row__date" aria-hidden="true">
                    <span class="event-row__month">{fmtMonth(event.data.start)}</span>
                    <span class="event-row__day">{fmtDay(event.data.start)}</span>
                  </span>
                  <span class="event-row__body">
                    <time datetime={event.data.start.toISOString()}>
                      {fmtWeekday(event.data.start)}, {fmtDate(event.data.start).replace(/^[A-Za-z]+, /, '')}
                    </time>
                    <h3>{event.data.title}</h3>
                    <p>{event.data.description}</p>
                  </span>
                </a>
              </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>The kinds of nights we host</h2>
      <div class="grid grid--five">
        <div class="card">
          <h3>Drag shows</h3>
          <p>A central part of our community: drag performances and showcases that celebrate queer artistry and bring people together.</p>
        </div>
        <div class="card">
          <h3>Local author readings</h3>
          <p>Appalachian writers, queer writers, poetry, and fiction.</p>
        </div>
        <div class="card">
          <h3>Acoustic music</h3>
          <p>Singer-songwriters and small, low-volume sets made for listening.</p>
        </div>
        <div class="card">
          <h3>Open mics &amp; art nights</h3>
          <p>Open mic evenings, rotating art features, and creative workshops.</p>
        </div>
        <div class="card">
          <h3>Community events</h3>
          <p>Queer community nights, sober-friendly gatherings, local vendor markets, mutual aid drives, and meetups centered on connection and care.</p>
        </div>
      </div>
    </div>
  </section>
  <EmailSignup heading="Get event announcements first" />
</Base>

<style>
  /* shorter banner so the events themselves sit nearer the top */
  .events-banner { aspect-ratio: 16 / 4.5; margin-bottom: var(--space-3); }
  @media (max-width: 640px) { .events-banner { aspect-ratio: 16 / 7; } }

  /* upcoming and recent events: one row per event with a date badge */
  .event-list {
    list-style: none;
    margin: var(--space-2) 0 var(--space-3);
    padding: 0;
    max-width: none; /* override the global ul reading-measure cap */
    display: grid;
    gap: var(--space-2);
  }
  .event-list li { margin: 0; }
  .event-row {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: var(--space-3);
    align-items: start;
    background: #fffdf6;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-2);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .event-row:hover,
  .event-row:focus-visible {
    border-color: var(--green);
    box-shadow: 0 4px 14px rgba(20, 58, 0, 0.1);
  }
  @media (prefers-reduced-motion: reduce) { .event-row { transition: none; } }
  .event-row__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--green-deep);
    color: var(--cream);
    border-radius: 8px;
    padding: 0.55rem 0.25rem 0.6rem;
    line-height: 1;
    text-align: center;
  }
  .event-row__month {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--honey);
  }
  .event-row__day {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }
  .event-row__body { min-width: 0; }
  .event-row__body time {
    display: block;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: var(--clay);
  }
  .event-row__body h3 { margin: 0.2rem 0 0.35rem; }
  .event-row__body p { margin: 0 0 0.4rem; }
  .event-row__more {
    display: inline-block;
    margin-top: 0.15rem;
    color: var(--green);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .event-list--past .event-row { opacity: 0.9; }
  @media (max-width: 560px) {
    .event-row { grid-template-columns: 4rem 1fr; gap: var(--space-2); padding: var(--space-2); }
    .event-row__day { font-size: 1.7rem; }
  }

  /* "also coming soon": a two-column set of cards instead of a narrow stack */
  .coming-soon-events { max-width: none; margin-top: var(--space-4); }
  .coming-soon-events h2 { margin-top: 0; }
  .coming-soon-events ul {
    grid-template-columns: repeat(2, 1fr);
    max-width: none;
    align-items: stretch;
  }
  .coming-soon-events .host-card--wide { grid-column: 1 / -1; }
  .coming-soon-events .host-card { height: 100%; }
  @media (max-width: 760px) { .coming-soon-events ul { grid-template-columns: 1fr; } }

  /* the "want to be part of it" call-out */
  .pitch-note {
    background: var(--cream-deep);
    border-left: 4px solid var(--honey);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-2) var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
    max-width: none;
  }
  .pitch-note p { margin: 0; max-width: none; }
</style>
