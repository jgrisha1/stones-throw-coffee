---
import Base from '../layouts/Base.astro';
import { BUSINESS, has } from '../config';

const formReady = has(BUSINESS.formspreeEndpoint);
---

<Base
  title="Local Art, Authors & Music | Stone's Throw Coffee Knoxville"
  description="Stone's Throw Coffee features local Knoxville artists, authors, musicians, and makers through rotating displays, readings, acoustic nights, and events."
>
  <div class="page-hero-img" aria-hidden="true" style="background: linear-gradient(rgba(20,58,0,0.65), rgba(20,58,0,0.45)), url('/images/local-art-makers-wall.webp') center / cover no-repeat; aspect-ratio: 16/6; width: 100%;"></div>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Made in Knoxville</p>
      <h1>Local Art, Authors &amp; Music</h1>
      <p class="lede">
        The walls, the shelves, and the calendar at Stone&rsquo;s Throw belong to Knoxville&rsquo;s
        makers. If you write, paint, sing, stitch, print, or perform, there&rsquo;s a place for
        you here.
      </p>

      <h2>Featured local artists</h2>
      <p>
        We rotate local art on our walls and stock vendor shelves with work by Knoxville makers —
        each feature comes with an artist bio, prices if the work is for sale, and a link back to
        the artist&rsquo;s own site or shop. Our first featured artists will be announced before
        opening day.
      </p>

      <h2>Author readings</h2>
      <p>
        Local authors are at the heart of our calendar: Appalachian writing, queer writers,
        poetry, memoir, fiction, and the occasional horror night with the lights turned low.
        Readings are intimate, friendly, and built so writers actually sell books and meet
        readers. Upcoming dates are on the <a href="/events/">events calendar</a>.
      </p>

      <h2>Acoustic music</h2>
      <p>
        Singer-songwriters and small acoustic sets, kept at a volume where you can still hear the
        person across the table. Evening sets are sober-friendly — great music with no pressure
        to drink anything stronger than a double shot. See <a href="/events/">what&rsquo;s
        coming up</a>.
      </p>

      <h2 id="apply">Apply to be featured</h2>
      <p>
        Artists, authors, musicians, poets, and makers — tell us about your work. We read
        everything and we book from this list first.
      </p>
      {
        formReady ? (
          <form class="stack" action={BUSINESS.formspreeEndpoint} method="POST">
            <label>
              Your name
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              Email
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label>
              I&rsquo;m a&hellip;
              <select name="discipline" required>
                <option value="">Choose one</option>
                <option>Visual artist</option>
                <option>Author / writer</option>
                <option>Musician</option>
                <option>Poet</option>
                <option>Maker / craftsperson</option>
                <option>Something else entirely</option>
              </select>
            </label>
            <label>
              Link to your work (website, Instagram, Bandcamp&hellip;)
              <input type="url" name="link" placeholder="https://" />
            </label>
            <label>
              Tell us about what you&rsquo;d like to do at Stone&rsquo;s Throw
              <textarea name="message" rows="5" required />
            </label>
            <input type="hidden" name="_subject" value="Artist/author feature application" />
            <button class="btn btn--clay" type="submit">
              Send application
            </button>
          </form>
        ) : (
          <div class="card" style="max-width: 38rem;">
            <!-- TODO: set formspreeEndpoint in src/config.ts to activate the application form -->
            <p style="margin:0;">
              {has(BUSINESS.email) ? (
                <>
                  Our application form opens soon. Until then, email us at{' '}
                  <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a> with a link to your
                  work.
                </>
              ) : (
                <>
                  Our application form opens soon. Check back here, or watch{' '}
                  <a href="/updates/">the Updates page</a> — we&rsquo;ll announce the moment
                  it&rsquo;s live.
                </>
              )}
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
