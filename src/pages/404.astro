---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Page Not Found | Stone's Throw Coffee"
  description="That page wandered off. Find the Stone's Throw Coffee menu, events, and visiting info from here."
  noindex
>
  <section class="section">
    <div class="wrap">
      <h1>Well, that page is gone.</h1>
      <p class="lede">
        Like a quiet table at open mic night, it may never have existed at all. Here&rsquo;s
        where you probably meant to go:
      </p>
      <div class="btn-row">
        <a class="btn btn--clay" href={`${base}/`}>Home</a>
        <a class="btn btn--clay" href={`${base}/menu/`}>Menu</a>
        <a class="btn btn--clay" href={`${base}/events/`}>Events</a>
        <a class="btn btn--clay" href={`${base}/visit/`}>Visit Us</a>
      </div>
    </div>
  </section>
</Base>
