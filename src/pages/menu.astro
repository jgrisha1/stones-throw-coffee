---
import Base from '../layouts/Base.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { MENU, FLAVORS, TEAS, formatPrice } from '../data/menu';
import { PARTNERS, PEOPLE, showPersonalNames } from '../data/partners';

// schema.org Menu structured data, generated from the same data the page
// renders - prices on the page and prices in search results can't drift.
const menuId = new URL('/menu/#menu', Astro.site).href;
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': menuId,
  url: new URL('/menu/', Astro.site).href,
  name: "Stone's Throw Coffee Menu",
  inLanguage: 'en',
  hasMenuSection: MENU.map((section) => ({
    '@type': 'MenuSection',
    name: section.name,
    hasMenuItem: section.items.map((item) => ({
      '@type': 'MenuItem',
      name: item.name,
      ...(item.description ? { description: item.description } : {}),
      offers: item.prices.map((p) => ({
        '@type': 'Offer',
        ...(p.label ? { name: p.label } : {}),
        price: p.amount.toFixed(2),
        priceCurrency: 'USD',
      })),
    })),
  })),
};
const base = import.meta.env.BASE_URL.replace(/\/$/,'');
---

<Base
  title="Menu | Stone's Throw Coffee in South Knoxville"
  description="Handcrafted lattes, dirty chai, specialty teas, matcha, drip, and mushroom coffee, priced like a South Knoxville neighborhood shop."
  jsonLd={[menuSchema]}
  menuRef={{ '@id': menuId }}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Drinks &amp; prices</p>
      <h1>The Menu</h1>
      <p class="lede">
        Handcrafted espresso drinks, chai, specialty teas, matcha, cocoa, and coffee, made in
        South Knoxville, priced like a neighborhood shop. One complimentary flavor is included
        with any drink, and whole milk, half and half, soy, oat, and almond milk are always
        available.
      </p>

      {
        MENU.map((section) => (
          <div class="menu-section">
            <h2>{section.name}</h2>
            {section.note && <p class="menu-section__note">{section.note}</p>}
            <ul style="list-style:none; padding:0; margin:0;">
              {section.items.map((item) => (
                <li class="menu-item" style="flex-wrap: wrap;">
                  <span class="menu-item__name">{item.name}</span>
                  <span class="menu-item__dots" aria-hidden="true" />
                  <span class="menu-item__price">
                    {item.prices.map(formatPrice).join(' / ')}
                  </span>
                  {item.description && <p class="menu-item__desc">{item.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="menu-section">
        <h2 id="food">Food</h2>
        <p class="menu-section__note">
          We&rsquo;re working on food options to pair with your drink. Details coming as we
          get closer to opening. Follow our <a href={`${base}/updates/`}>updates</a> for the latest.
        </p>
      </div>

      <h2 id="teas">Loose Leaf Teas</h2>
      <ul class="tea-list">
        {TEAS.map((tea) => (
          <li>
            <span class="tea-list__name">{tea.name}</span>
            {tea.notes && <span class="tea-list__notes">{tea.notes}</span>}
          </li>
        ))}
      </ul>

      <div class="media-banner" aria-hidden="true" style={`background-image: url('${base}/images/menu-flavors-botanical-syrups.webp'); margin-top: var(--space-4);`}></div>

      <h2 id="flavors">Flavors</h2>
      <p>
        Choose from classic coffeehouse flavors, cozy bakery flavors, nutty favorites, and
        sugar-free options. One flavor is complimentary with each eligible drink; additional
        flavors are $0.25 each.
      </p>
      <ul class="flavor-list">
        {FLAVORS.map((flavor) => <li>{flavor}</li>)}
      </ul>

      <h2 id="mushroom-coffee">About our mushroom coffee</h2>
      <p>
        If you&rsquo;ve been searching for mushroom coffee in Knoxville, this is ours. Our Mushroom
        Coffee combines chaga powder with an iced latte. Chaga adds a mild, earthy note while the
        espresso and milk keep the drink familiar. Follow our
        <a href={`${base}/updates/`}>updates</a> for opening details and event announcements.
      </p>
      <h2 id="community-partners">Community Partners &amp; Associations</h2>
      <p>
        At Stone&rsquo;s Throw Coffee, we believe a local coffee shop should be built with local
        hands whenever possible. We&rsquo;re proud to partner with local
        businesses who share our commitment to community:
      </p>
      <ul class="partner-grid">
        {
          PARTNERS.filter((p) => p.image).map((p) => (
            <li class="partner-card">
              {p.full ? (
                <a
                  class="partner-card__img partner-card__zoom"
                  href={`${base}/images/partners/${p.full}`}
                  data-lightbox
                  data-alt={p.alt}
                  aria-label={`Enlarge the ${p.name} image`}
                >
                  <img src={`${base}/images/partners/${p.image}`} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
                  <span class="partner-card__hint" aria-hidden="true">Tap to enlarge</span>
                </a>
              ) : (
                <div class="partner-card__img">
                  <img src={`${base}/images/partners/${p.image}`} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
                </div>
              )}
              <p class="partner-card__name">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                ) : (
                  p.name
                )}
              </p>
            </li>
          ))
        }
      </ul>
      <dialog class="lightbox" id="lightbox" aria-label="Enlarged image">
        <button type="button" class="lightbox__close" aria-label="Close enlarged image">&times;</button>
        <img src="" alt="" />
      </dialog>
      <ul class="event-meta">
        {
          PARTNERS.filter((p) => !p.image).map((p) => (
            <li>
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.name}
                </a>
              ) : (
                p.name
              )}
            </li>
          ))
        }
      </ul>
      {
        showPersonalNames && (
          <ul class="event-meta">
            {PEOPLE.map((p) => (
              <li>
                <strong>{p.role}:</strong> {p.name}
              </li>
            ))}
          </ul>
        )
      }

      <p>
        <em>Final opening prices may shift as costs and supplies change. We&rsquo;ll keep this page
        updated as opening day gets closer.</em>
      </p>
    </div>
  </section>
  <EmailSignup heading="Menu specials, straight to your inbox" />
</Base>

<script>
  // Click-to-enlarge for partner images. Without JS the link just opens the big image.
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const big = dlg?.querySelector('img') as HTMLImageElement | null;
  if (dlg && big && typeof dlg.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        big.src = a.href;
        big.alt = a.dataset.alt || '';
        dlg.showModal();
      });
    });
    dlg.querySelector('.lightbox__close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // click on the dark backdrop
    });
  }
</script>

<style>
  .partner-grid {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    max-width: none; /* override the global ul reading-measure cap */
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }
  .partner-card {
    margin: 0;
    background: #fffdf6;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .partner-card__img {
    background: #fff;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-card__img img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .partner-card__name {
    margin: 0;
    padding: 0.75rem 1rem;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    font-size: 1.05rem;
    border-top: 1px solid var(--line);
  }
  .partner-card__zoom {
    position: relative;
    cursor: zoom-in;
  }
  .partner-card__hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    background: rgba(20, 58, 0, 0.9);
    color: #faf4e7;
    font-size: 0.85rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }
  .partner-card__zoom:focus-visible { outline: 3px solid var(--honey); outline-offset: -3px; }
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 96vw;
    max-height: 96vh;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgba(10, 20, 5, 0.85); }
  .lightbox img {
    display: block;
    max-width: 96vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    border-radius: var(--radius);
    background: #fff;
  }
  .lightbox__close {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #faf4e7;
    background: #143a00;
    color: #faf4e7;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox__close:focus-visible { outline: 3px solid var(--honey); outline-offset: 2px; }
  /* phones: show the image large and let people scroll or pinch around it, with the close button pinned */
  @media (max-width: 600px) {
    .lightbox {
      max-width: 100vw;
      max-height: 100vh;
      width: 100vw;
      height: 100vh;
      overflow: auto;
      -webkit-overflow-scrolling: touch;
    }
    .lightbox img {
      max-width: none;
      max-height: none;
      width: 200vw;
      margin: 3.5rem 0 1rem;
      border-radius: 0;
    }
    .lightbox__close { position: fixed; top: 0.5rem; right: 0.5rem; }
  }
</style>
