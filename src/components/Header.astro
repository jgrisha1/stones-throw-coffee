---
import { BUSINESS } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/menu/`, label: 'Menu' },
  { href: `${base}/events/`, label: 'Events' },
  { href: `${base}/our-story/`, label: 'Our Story' },
  { href: `${base}/support-us/`, label: 'Support Us', cta: true },
  { href: `${base}/art-and-authors/`, label: 'Local Art & Makers' },
  { href: `${base}/visit/`, label: 'Visit Us' },
  { href: `${base}/contact/`, label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => {
  // Strip base prefix for comparison so active state works correctly
  const stripped = href.replace(base, '') || '/';
  return path.endsWith(stripped) || (stripped !== '/' && path.includes(stripped));
};
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={`${base}/`} aria-label={`${BUSINESS.name} — home`}>
      <img src={`${base}/images/logo.webp`} alt={BUSINESS.name} width="112" height="111" loading="eager" />
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav-list"
      aria-label="Open navigation menu"
    >
      <svg class="icon-menu" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect x="2" y="5" width="18" height="2" rx="1" fill="currentColor" />
        <rect x="2" y="10" width="18" height="2" rx="1" fill="currentColor" />
        <rect x="2" y="15" width="18" height="2" rx="1" fill="currentColor" />
      </svg>
      <svg class="icon-close" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M5 5l12 12M17 5l-12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="site-nav" aria-label="Main">
      <ul id="site-nav-list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={link.cta ? 'nav-cta' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.site-nav');

  function openNav() {
    nav?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close navigation menu');
  }

  function closeNav() {
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open navigation menu');
  }

  toggle?.addEventListener('click', () => {
    nav?.classList.contains('is-open') ? closeNav() : openNav();
  });

  // Close when a link is activated
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (nav?.classList.contains('is-open') &&
        !nav.contains(e.target as Node) &&
        !toggle?.contains(e.target as Node)) {
      closeNav();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      closeNav();
      toggle?.focus();
    }
  });
</script>
