---
import { BUSINESS, has } from '../config';

interface Props {
  heading?: string;
}

const { heading = 'Stay in the loop' } = Astro.props;
const ready = has(BUSINESS.newsletterAction);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// avoid a circular "the Updates page" link when this band is on /updates/ itself
const onUpdates = Astro.url.pathname.replace(/\/?$/, '/') === `${base}/updates/`;
---

<section class="section section--pine section--botanical signup-band" aria-labelledby="signup-heading">
  <svg class="botanical botanical--side botanical--sprig" viewBox="0 0 100 160" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M50 160 C 50 120, 46 92, 60 26" />
      <path d="M52 130 C 40 126, 34 118, 30 110" />
      <path d="M53 118 C 66 114, 74 106, 78 98" />
      <path d="M51 104 C 39 100, 33 92, 30 84" />
      <path d="M54 92 C 67 88, 74 80, 77 72" />
      <path d="M53 78 C 42 74, 36 66, 33 58" />
      <path d="M56 64 C 68 60, 74 52, 76 44" />
      <path d="M58 48 C 51 40, 51 31, 57 23" />
    </g>
  </svg>
  <div class="wrap">
    <h2 id="signup-heading" style="margin-top:0;">{heading}</h2>
    <p>
      Get event announcements, menu specials, and local artist features. No spam, no selling your
      info. Just what&rsquo;s happening as we build the shop.
    </p>
    {
      ready ? (
        <form action={BUSINESS.newsletterAction} method="post" target="_blank">
          {/* Labels the submission in the inbox so signups are distinct from contact messages. */}
          <input type="hidden" name="_subject" value="New email-list signup: Stone's Throw Coffee" />
          {/* Honeypot: bots fill this; real users never see it, so filled = spam, dropped by Formspree. */}
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
          <label class="visually-hidden" for="signup-email">
            Email address
          </label>
          <input
            id="signup-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
          />
          <button class="btn btn--solid" type="submit">
            Sign up
          </button>
        </form>
      ) : (
        <p>
          <!-- TODO: set newsletterAction in src/config.ts to replace this fallback with a signup form -->
          Our email list is opening soon. {has(BUSINESS.social.instagram) ? (
            <>
              <a href={BUSINESS.social.instagram} rel="noopener">Follow us on Instagram</a> for
              announcements in the meantime, or watch{' '}
              {onUpdates ? 'this page' : <a href={`${base}/updates/`}>the Updates page</a>}.
            </>
          ) : onUpdates ? (
            'Until then, announcements land first right here on this page.'
          ) : (
            <>Until then, announcements land first on <a href={`${base}/updates/`}>the Updates page</a>.</>
          )}
        </p>
      )
    }
  </div>
</section>
