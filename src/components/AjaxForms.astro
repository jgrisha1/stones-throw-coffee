---
/**
 * Submits any <form data-ajax-form> to Formspree in the background and shows the result right
 * on the page, so visitors never get sent to Formspree's own thank-you page (on a phone that
 * means a tab or a back-button trip away from the site).
 *
 * Progressive enhancement: without JavaScript the form still posts normally. The message shown
 * on success comes from the form's data-success attribute. The status line is created up front
 * as a polite live region so screen readers announce it.
 */
---

<script is:inline>
  (function () {
    var forms = document.querySelectorAll('form[data-ajax-form]');
    for (var i = 0; i < forms.length; i++) {
      setup(forms[i]);
    }

    function setup(form) {
      var status = document.createElement('p');
      status.className = 'form-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.tabIndex = -1;
      form.insertAdjacentElement('afterend', status);

      form.addEventListener('submit', function (e) {
        // The browser only fires submit once required fields are valid, so validation messages
        // still come from the browser itself.
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var label = btn ? btn.textContent : '';
        status.removeAttribute('data-state');
        status.textContent = 'Sending…';
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Sending…';
        }
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
          .then(function (res) {
            if (!res.ok) throw new Error('bad response');
            form.setAttribute('hidden', '');
            status.textContent = form.getAttribute('data-success') || 'Thanks! We got it.';
            status.focus(); // keyboard and screen-reader users land on the confirmation
          })
          .catch(function () {
            if (btn) {
              btn.disabled = false;
              btn.textContent = label;
            }
            status.setAttribute('data-state', 'error');
            status.textContent =
              form.getAttribute('data-error') || 'Something went wrong. Please try again.';
          });
      });
    }
  })();
</script>
